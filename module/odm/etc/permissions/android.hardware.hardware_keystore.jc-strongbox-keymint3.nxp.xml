<?xml version="1.0" encoding="utf-8"?>
<!-- RHSO overlay: replaces the OnePlus 15R (CPH2771) ODM keystore feature file without its StrongBox
     keystore feature. TEESimulator signs simulated StrongBox keys with a TEE keybox chain, so apps are
     steered to TEE keys instead. app_attest_key is kept. -->
<permissions>
  <feature name="android.hardware.keystore.app_attest_key" />
</permissions>
